* text eol=lf
*.patch binary
*.bat binary
*.exe binary
*.ico binary
# lockfile diffs are big
environments/conda-lock.yml linguist-generated
environments/conda-lock-*.yaml linguist-generated
# Treat vendor folder as vendored and generated
conda_lock/_vendor/** linguist-vendored linguist-generated
# GitHub syntax highlighting
pixi.lock linguist-language=YAML linguist-generated=true
